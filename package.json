{
    "name": "expense-web",
    "description": "This is the web part of the expense app",
    "author": "Mohammad Nowresideh",
    "private": true,
    "packageManager": "pnpm@10.29.2",
    "version": "1.1.4",
    "type": "module",
    "engines": {
        "node": "24"
    },
    "scripts": {
        "prepare": "husky",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "format": "prettier --write .",
        "lint:fix": "eslint . --fix",
        "lint:ci": "eslint . --max-warnings=0",
        "format:ci": "prettier --check .",
        "knip": "knip",
        "install:ci": "pnpm install --ignore-scripts --frozen-lockfile",
        "prepare:release": "prettier --write CHANGELOG.md package.json",
        "eslint:security:scan": "pnpm exec eslint . --ext js,ts --plugin security --config eslint.config.mjs",
        "ts:compilation:security:scan": "tsc --project tsconfig.security.json",
        "ts:tsec:security:scan": "tsec --project tsconfig.security.json",
        "name:app:docker:image": "bash ./scripts/app/docker-image-name.sh",
        "push:app:docker:image": "bash ./scripts/app/docker-image-push.sh",
        "tag:app:docker:image": "bash ./scripts/app/docker-image-tag.sh",
        "start:docker:development": "bash ./scripts/app/docker-entrypoint-development.sh",
        "start:docker:ci": "bash ./scripts/app/docker-entrypoint-ci.sh",
        "start:docker:production": "bash ./scripts/app/docker-entrypoint-production.sh",
        "create:branch:id": "bash ./scripts/branch-id-creation.sh",
        "api:generate": "orval",
        "api:generate:watch": "orval --watch"
    },
    "dependencies": {
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@tanstack/react-query": "^5.106.1",
        "axios": "^1.21.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "tailwind-variants": "^4.0.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/npm": "^13.2.0",
        "@tailwindcss/vite": "^4.3.4",
        "@tanstack/react-query-devtools": "^5.107.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "branch-name-lint": "^3.0.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-security": "^4.2.1",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "knip": "^6.44.1",
        "lint-staged": "^17.6.0",
        "orval": "^8.46.0",
        "prettier": "^3.9.10",
        "semantic-release": "^25.0.9",
        "tailwindcss": "^4.3.4",
        "tsec": "^0.2.9",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5"
    }
}
